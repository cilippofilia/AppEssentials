{
  "sourceLanguage": "en",
  "strings": {
    "A button appears in the top corner of the screen while the apps are jiggling.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während die Apps wackeln, erscheint oben in der Ecke eine Taste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras las apps se mueven, aparece un botón en la esquina superior de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bouton apparaît dans le coin supérieur de l'écran pendant que les apps tremblent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mentre le app si muovono, compare un pulsante nell'angolo in alto dello schermo."
          }
        }
      }
    },
    "Add a Widget": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget hinzufügen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir un widget"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un widget"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un widget"
          }
        }
      }
    },
    "Changelog": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versionsverlauf"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Historial de versiones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Historique des versions"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cronologia versioni"
          }
        }
      }
    },
    "Contact the developer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwickler kontaktieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contactar al desarrollador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacter le développeur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contatta lo sviluppatore"
          }
        }
      }
    },
    "Control-click the desktop and choose Edit Widgets.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke bei gedrückter Ctrl-Taste auf den Schreibtisch und wähle „Widgets bearbeiten“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en el escritorio con la tecla Control pulsada y elige Editar widgets."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le bureau en maintenant la touche Contrôle enfoncée, puis choisissez Modifier les widgets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sulla scrivania tenendo premuto Ctrl e scegli Modifica widget."
          }
        }
      }
    },
    "Drag it to the desktop": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf den Schreibtisch ziehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrástralo al escritorio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites-le glisser sur le bureau"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascinalo sulla scrivania"
          }
        }
      }
    },
    "Drag the widget you want onto the desktop.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe das gewünschte Widget auf den Schreibtisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra el widget que quieras al escritorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser le widget de votre choix sur le bureau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina il widget che vuoi sulla scrivania."
          }
        }
      }
    },
    "Open the widget gallery": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgetgalerie öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la galería de widgets"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la galerie de widgets"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la galleria dei widget"
          }
        }
      }
    },
    "Other Enquiry": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Anfrage"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra consulta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autre demande"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altre richieste"
          }
        }
      }
    },
    "Pick a size and add it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Größe wählen und hinzufügen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un tamaño y añádelo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une taille et ajoutez-le"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una dimensione e aggiungilo"
          }
        }
      }
    },
    "Press and hold an empty area until the apps start to jiggle.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte einen leeren Bereich gedrückt, bis die Apps zu wackeln beginnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada una zona vacía hasta que las apps empiecen a moverse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le doigt sur une zone vide jusqu'à ce que les apps se mettent à trembler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuta un'area vuota finché le app non iniziano a muoversi."
          }
        }
      }
    },
    "Rate the app": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App bewerten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Valorar la app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évaluer l'app"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Valuta l'app"
          }
        }
      }
    },
    "Report a bug": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehler melden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reportar un error"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reporter un bug"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa di un bug"
          }
        }
      }
    },
    "Request a Feature": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feature anfragen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitar una función"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander une fonctionnalité"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiedi una feature"
          }
        }
      }
    },
    "Search for %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach %@ suchen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca %@"
          }
        }
      }
    },
    "Select an option": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Option auswählen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una opción"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir une option"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona un'opzione"
          }
        }
      }
    },
    "Share the app": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App teilen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir la app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager l'app"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi l'app"
          }
        }
      }
    },
    "Swipe between the available sizes, then tap Add Widget.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische zwischen den verfügbaren Größen und tippe dann auf „Widget hinzufügen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza entre los tamaños disponibles y toca Añadir widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez entre les tailles disponibles, puis touchez Ajouter un widget."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri tra le dimensioni disponibili, poi tocca Aggiungi widget."
          }
        }
      }
    },
    "Tap the Edit button, then Add Widget": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Bearbeiten“ und dann auf „Widget hinzufügen“"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Editar y luego Añadir widget"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Modifier, puis Ajouter un widget"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Modifica, poi Aggiungi widget"
          }
        }
      }
    },
    "Touch and hold the Home Screen": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Home-Bildschirm gedrückt halten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la pantalla de inicio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le doigt sur l'écran d'accueil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto sulla schermata Home"
          }
        }
      }
    },
    "Type “%@” in the search field to find the widget.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib „%@“ in das Suchfeld ein, um das Widget zu finden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe «%@» en el campo de búsqueda para encontrar el widget."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez « %@ » dans le champ de recherche pour trouver le widget."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi “%@” nel campo di ricerca per trovare il widget."
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versión %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Versione %@"
          }
        }
      }
    }
  },
  "version": "1.0"
}
